{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ESNext",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "#sdk": [
        "./work/ts/index.ts"
      ]
    }
  },
  "include": [
    "work/**/*.ts"
  ]
}
