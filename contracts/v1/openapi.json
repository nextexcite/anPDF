  "components": {
    "schemas": {
      "Input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative regular-file path inside a configured workspace root; URLs, traversal and symlink escape forbidden."
          }
        },
        "required": [
          "path"
        ]
      },
      "Output": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative regular-file path inside a configured workspace root; URLs, traversal and symlink escape forbidden."
          },
          "replaceExisting": {
            "type": "boolean",
            "default": false,
            "description": "Allows replacing a distinct output only; never any input."
          }
        },
        "required": [
          "path"
        ]
      },
      "InspectRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "$ref": "#/components/schemas/Input"
          }
        },
        "required": [
          "input"
        ]
      },
      "MergeRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Input"
            }
          },
          "output": {
            "$ref": "#/components/schemas/Output"
          }
        },
        "required": [
          "inputs",
          "output"
        ]
      },
      "ExtractRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Strictly increasing 1-based page numbers within source bounds."
          },
          "output": {
            "$ref": "#/components/schemas/Output"
          }
        },
        "required": [
          "input",
          "pages",
          "output"
        ]
      },
      "SplitPart": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2000,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "description": "Strictly increasing 1-based page numbers within source bounds."
          },
          "output": {
            "$ref": "#/components/schemas/Output"
          }
        },
        "required": [
          "pages",
          "output"
        ]
      },
      "SplitRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "input": {
            "$ref": "#/components/schemas/Input"
          },
          "parts": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/SplitPart"
            }
          }
        },
        "required": [
          "input",
          "parts"
        ]
      },
      "SplitResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "outputs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/Artifact"
            }
          }
        },
        "required": [
          "outputs"
        ]
      },
      "Warning": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ]
      },
      "Artifact": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "description": "Relative regular-file path inside a configured workspace root; URLs, traversal and symlink escape forbidden."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "pageCount": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "pageCount"
        ]
      },
      "DocumentMetadata": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "creator": {
            "type": "string"
          },
          "producer": {
            "type": "string"
          }
        }
      },
      "PageInfo": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pageNumber": {
            "type": "integer",
            "minimum": 1
          },
          "widthPoints": {
            "type": "number",
            "minimum": 0
          },
          "heightPoints": {
            "type": "number",
            "minimum": 0
          },
          "rotation": {
            "type": "integer",
            "enum": [
              0,
              90,
              180,
              270
            ]
          },
          "label": {
            "type": "string"
          }
        },
        "required": [
          "pageNumber",
          "rotation"
        ]
      },
      "InspectResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "pageCount": {
            "type": "integer",
            "minimum": 0
          },
          "pdfVersion": {
            "type": "string"
          },
          "structuralStatus": {
            "type": "string",
            "enum": [
              "valid",
              "warnings"
            ]
          },
          "encrypted": {
            "type": "boolean"
          },
          "forms": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          },
          "signatures": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          },
          "signatureValidity": {
            "type": "string",
            "enum": [
              "notChecked"
            ]
          },
          "actions": {
            "type": "string",
            "enum": [
              "present",
              "absent",
              "unknown"
            ]
          },
          "hasOutline": {
            "type": "boolean"
          },
          "hasAttachments": {
            "type": "boolean"
          },
          "metadata": {
            "$ref": "#/components/schemas/DocumentMetadata"
          },
          "pages": {
            "type": "array",
            "maxItems": 2000,
            "items": {
              "$ref": "#/components/schemas/PageInfo"
            }
          }
        },
        "required": [
          "sha256",
          "bytes",
          "pageCount",
          "pdfVersion",
          "structuralStatus",
          "encrypted",
          "forms",
          "signatures",
          "signatureValidity",
          "actions",
          "hasOutline",
          "hasAttachments",
          "metadata",
          "pages"
        ]
      },
      "inspectPdfSuccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "operationId": {
            "type": "string",
            "enum": [
              "inspectPdf"
            ]
          },
          "result": {
            "$ref": "#/components/schemas/InspectResult"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "required": [
          "contractVersion",
          "operationId",
          "result",
          "warnings"
        ]
      },
      "mergePdfSuccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "operationId": {
            "type": "string",
            "enum": [
              "mergePdf"
            ]
          },
          "result": {
            "$ref": "#/components/schemas/Artifact"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "required": [
          "contractVersion",
          "operationId",
          "result",
          "warnings"
        ]
      },
      "extractPdfSuccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "operationId": {
            "type": "string",
            "enum": [
              "extractPdf"
            ]
          },
          "result": {
            "$ref": "#/components/schemas/Artifact"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "required": [
          "contractVersion",
          "operationId",
          "result",
          "warnings"
        ]
      },
      "splitPdfSuccess": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "operationId": {
            "type": "string",
            "enum": [
              "splitPdf"
            ]
          },
          "result": {
            "$ref": "#/components/schemas/SplitResult"
          },
          "warnings": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Warning"
            }
          }
        },
        "required": [
          "contractVersion",
          "operationId",
          "result",
          "warnings"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contractVersion": {
            "type": "string",
            "enum": [
              "1.0.0"
            ]
          },
          "operationId": {
            "type": "string",
            "description": "Requested operation ID; unknown when parsing did not resolve an operation."
          },
          "error": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "INVALID_REQUEST",
                  "NOT_FOUND",
                  "ACCESS_DENIED",
                  "OUTPUT_EXISTS",
                  "INPUT_CHANGED",
                  "INVALID_PDF",
                  "ENCRYPTED_UNSUPPORTED",
                  "SIGNED_UNSUPPORTED",
                  "FORM_UNSUPPORTED",
                  "PRESERVATION_UNKNOWN",
                  "UNSUPPORTED_OPERATION",
                  "LIMIT_EXCEEDED",
                  "TIMEOUT",
                  "BACKEND_UNAVAILABLE",
                  "INTERNAL",
                  "UNAUTHENTICATED"
                ]
              },
              "message": {
                "type": "string"
              },
              "retryable": {
                "type": "boolean"
              }
            },
            "required": [
              "code",
              "message",
              "retryable"
            ]
          }
        },
        "required": [
          "contractVersion",
          "operationId",
          "error"
        ]
      }
    },
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer"
      }
